# API 服务配置
APP_ADDR=:8080

# 数据库配置
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reqsplit?sslmode=disable

# AI Provider 配置
# 可选值: stub (测试用) 或 openai (真实 AI)
AI_PROVIDER=stub

# OpenAI API 配置（使用 openai provider 时需要）
AI_API_KEY=sk-your-api-key-here

# OpenAI API 地址（可选，默认官方地址）
AI_API_URL=https://api.openai.com/v1/chat/completions

# AI 模型名称（可选，默认 gpt-4o）
AI_MODEL=gpt-4o
